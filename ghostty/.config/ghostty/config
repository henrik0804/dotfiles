# The syntax is "key = value". The whitespace around the
# equals doesn't matter.
theme = tokyonight
# Empty values reset the configuration to the default value
font-family = "Jet Brains Mono Nerd Font"
font-size = 25
cursor-style = block
shell-integration-features = no-cursor
background-opacity = 0.8
window-subtitle = false

macos-titlebar-style = hidden
macos-window-buttons = hidden
macos-titlebar-proxy-icon = hidden
# Keep false so Option+L (@ etc.) and Option-based | stay normal typing.
# Agent jumps use ctrl+alt+1..9 in Herdr instead of Option+digit.
macos-option-as-alt = false

window-padding-x=10
window-padding-y=10
window-padding-balance=true

mouse-hide-while-typing=true

# Ctrl+1..9 used to be rewritten as ESC+N so tmux could see Meta-N.
# Herdr (and modern tmux with extended-keys) want the real Ctrl+N chord.
# Leave unbound so the terminal app receives ctrl+1..9 natively.
# keybind = ctrl+1=text:\x1b1
# keybind = ctrl+2=text:\x1b2
# keybind = ctrl+3=text:\x1b3
# keybind = ctrl+4=text:\x1b4
# keybind = ctrl+5=text:\x1b5
# keybind = ctrl+6=text:\x1b6
# keybind = ctrl+7=text:\x1b7
# keybind = ctrl+8=text:\x1b8
# keybind = ctrl+9=text:\x1b9

keybind = opt+h=text:\x1bh
keybind = super+o=text:\x1bo
