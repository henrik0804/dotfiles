.DS_Store
.ansible-vault-password
.vault-password

# Never commit decrypted secret material. Encrypted Ansible Vault files are OK.
secrets/**
!secrets/
!secrets/**/
!secrets/.keep
!secrets/**/*.vault
nvim/.config/nvim/lazy-lock.json

# OpenCode owns and rotates its local background-service credentials.
opencode/.config/opencode/service*.json

# Local backups
*.bak

# Agent skills are installed from github.com/henrik0804/agent-skills via skills.sh.
# Do not track generated/symlinked skill installs in this dotfiles repo.
opencode/.config/opencode/skill/
opencode/.config/opencode/skills/
pi/.pi/agent/skills/
codex/.codex/skills/
claude/.claude/skills/
